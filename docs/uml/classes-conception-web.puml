@startuml classes-conception-web
title Conception MVC (1/2) : filtres, contrôleurs et services
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
left to right direction

package "filter" {
  class EncodingFilter <<"/*" (web.xml)>> {
    + doFilter(req, rep, chaine)
  }
  class AuthFilter <<"/client/*" (web.xml)>> {
    + doFilter(req, rep, chaine)
  }
  class AdminFilter <<"/admin/*" (web.xml)>> {
    + doFilter(req, rep, chaine)
  }
}

package "controller" {
  class InscriptionServlet <<"/inscription">>
  class ConnexionServlet <<"/connexion">>
  class DeconnexionServlet <<"/deconnexion">>
  class CatalogueServlet <<"/catalogue">>
  class ProduitServlet <<"/produit">>
  class ProfilServlet <<"/client/profil">>
  class PanierServlet <<"/client/panier">>
  class CommandeServlet <<"/client/commandes">>
  class AdminCategorieServlet <<"/admin/categories">>
  class AdminProduitServlet <<"/admin/produits">>
  class AdminCommandeServlet <<"/admin/commandes">>
  class AdminUtilisateurServlet <<"/admin/utilisateurs">>
  class TableauDeBordServlet <<"/admin/tableau-de-bord">>
}

package "service" {
  class AuthService
  class CatalogueService
  class PanierService
  class CommandeService
}

package "WEB-INF/views" {
  class "JSP (client, admin, commun)" as JSP <<vue>>
}

EncodingFilter ..> AuthFilter : chaîne (ordre fixé dans web.xml)
EncodingFilter ..> AdminFilter : chaîne
AuthFilter ..> ProfilServlet
AuthFilter ..> PanierServlet
AuthFilter ..> CommandeServlet
AdminFilter ..> AdminCategorieServlet
AdminFilter ..> AdminProduitServlet
AdminFilter ..> AdminCommandeServlet
AdminFilter ..> AdminUtilisateurServlet
AdminFilter ..> TableauDeBordServlet

' Contrôleurs -> services
InscriptionServlet ..> AuthService
ConnexionServlet ..> AuthService
ProfilServlet ..> AuthService
AdminUtilisateurServlet ..> AuthService
CatalogueServlet ..> CatalogueService
ProduitServlet ..> CatalogueService
AdminCategorieServlet ..> CatalogueService
AdminProduitServlet ..> CatalogueService
PanierServlet ..> PanierService
CommandeServlet ..> CommandeService
AdminCommandeServlet ..> CommandeService
TableauDeBordServlet ..> CommandeService
TableauDeBordServlet ..> CatalogueService

controller ..> JSP : forward

note bottom of AuthFilter
  BNF02, RG08 : utilisateur connecté avec le rôle CLIENT ;
  non connecté : redirection vers /connexion,
  ADMIN : redirection vers /admin/tableau-de-bord
end note
note bottom of AdminFilter
  BNF02 : rôle ADMIN obligatoire ;
  non connecté : redirection vers /connexion,
  connecté sans le rôle ADMIN : erreur 403
end note
note bottom of EncodingFilter
  Les trois filtres sont déclarés dans web.xml :
  l'ordre des filter-mapping (EncodingFilter,
  AuthFilter, AdminFilter) est celui de la chaîne
end note
@enduml
